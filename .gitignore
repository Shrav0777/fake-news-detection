models/*.pkl
models/*.joblib

# Results (generated during evaluation)
results/*.png
results/*.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Distribution / packaging
*.egg-info/
dist/
build/
